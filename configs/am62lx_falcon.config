CONFIG_SPL_OS_BOOT=y
# CONFIG_SPL_OS_BOOT_SECURE is not set

CONFIG_SPL_OS_BOOT_ARGS=y
CONFIG_SYS_SPI_U_BOOT_OFFS=0x180000
CONFIG_SYS_SPI_KERNEL_OFFS=0x300000
CONFIG_SYS_SPI_ARGS_OFFS=0x1ff0000

CONFIG_SYS_SPI_ARGS_SIZE=0x10000
CONFIG_SPL_PAYLOAD_ARGS_ADDR=0x86f00000
CONFIG_SPL_SPI_FLASH_SUPPORT=y

# Disable all unsupported boot media to save space
# CONFIG_SPL_MMC is not set
# CONFIG_SPL_SYS_MMCSD_RAW_MODE is not set
# CONFIG_SPL_YMODEM_SUPPORT is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_SPL_NAND_SUPPORT is not set
# CONFIG_SPL_NOR_SUPPORT is not set
# CONFIG_SPL_RAM_DEVICE is not set
# CONFIG_SPL_FS_FAT is not set
# CONFIG_SPL_DFU is not set
# CONFIG_SPL_MTD is not set
