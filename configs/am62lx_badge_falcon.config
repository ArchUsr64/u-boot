CONFIG_CMD_SPL=y
CONFIG_SPL_OS_BOOT=y
CONFIG_SPL_OS_BOOT_SECURE=n
CONFIG_SPL_FS_FAT=y
CONFIG_SPL_OS_BOOT_ALLOW_FALLBACK=y
CONFIG_SPL_FALCON_LOAD_ARGS=y
CONFIG_SPL_FS_LOAD_KERNEL_NAME="Image"
CONFIG_SYS_MMCSD_FS_BOOT_PARTITION=1
CONFIG_SPL_FS_LOAD_ARGS_NAME="falcon.dtb"
CONFIG_SPL_PAYLOAD_ARGS_ADDR=0x84000000
CONFIG_TEXT_BASE=0x86000000

# Disable all unsupported boot media to save space
# CONFIG_SPL_SYS_MMCSD_RAW_MODE is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_YMODEM_SUPPORT is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_SPL_NAND_SUPPORT is not set
# CONFIG_SPL_NOR_SUPPORT is not set
# CONFIG_SPL_RAM_DEVICE is not set
# CONFIG_SPL_MTD is not set
